        ]
      },
      "preprocess": {
        "layout": "NCHW",
        "color": "RGB",
        "resize": "5-point similarity-transform alignCrop to 112x112 using the ArcFace reference landmarks (x,y): [[38.2946,51.6963],[73.5318,51.5014],[56.0252,71.7366],[41.5493,92.3655],[70.7299,92.2041]] in the order left-eye, right-eye, nose, left-mouth-corner, right-mouth-corner - SCRFD kps are already in that order",
        "formula": "pixel_rgb (raw 0-255, NO /255, NO mean, NO std)",
        "mean": [
          0.0,
          0.0,
          0.0
        ],
        "std": [
          1.0,
          1.0,
          1.0
        ],
        "source": "opencv/modules/objdetect/src/face_recognize.cpp: blobFromImage(aligned, 1, Size(112,112), Scalar(0,0,0), swapRB=true, crop=false)"
      },
      "postprocess": "fc1 is a 128-d embedding that is NOT L2-normalised by the graph - the caller must normalise before comparing. OpenCV match thresholds: cosine similarity >= 0.363 -> same identity; L2 distance on the normalised vectors <= 1.128 -> same identity."
    }
