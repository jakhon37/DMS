      "preprocess": {
        "layout": "NCHW",
        "color": "RGB",
        "resize": "letterbox to the frozen HxW, top-left, pad 0",
        "formula": "(pixel_rgb - 127.5) / 128.0",
        "mean": [
          127.5,
          127.5,
          127.5
        ],
        "scale": 0.0078125
      },
      "postprocess": "InsightFace SCRFD 3-stride decode (8/16/32), 2 anchors per cell; outputs are grouped score(N,1)/bbox(N,4)/kps(N,10) per stride in that order. See dms/infer/scrfd.py."
    },
