      "bytes": 2524817,
      "license": "MIT (InsightFace/UniFace attribution)",
      "cookbook": "https://github.com/yakhyo/uniface",
      "input_name": "input.1",
      "input_shape": [
        1,
        3,
        -1,
        -1
      ],
      "input_dtype": "FLOAT",
      "output_names": [
