    "head_pose": {
      "id": "hpe_mobilenetv2",
      "file": "hpe_mobilenetv2.onnx",
      "url": "https://github.com/yakhyo/head-pose-estimation/releases/download/weights/mobilenetv2.onnx",
      "sha256": "1e902872868e483bd0e4f8f4a8ff2a4d61c2ccbca9dadf748e5479b5cc86a9e9",
      "bytes": 8905103,
      "license": "MIT (yakhyo/head-pose-estimation, 6DRepNet-derived). Weights trained on 300W-LP, evaluated on AFLW2000 - both research corpora; MIT applies to code and released weights.",
